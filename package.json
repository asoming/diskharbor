{
  "name": "diskharbor",
  "version": "0.1.0-alpha.14",
  "private": true,
  "description": "DiskHarbor / 盘清 — understand your storage",
  "author": "asoming",
  "license": "MIT",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test --test-isolation=none tests/*.test.cjs",
    "preview": "vite --host 127.0.0.1",
    "pack": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux deb tar.gz",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "test:desktop": "node scripts/smoke.cjs",
    "test:cleanup-review": "node scripts/cleanup-review-smoke.cjs",
    "test:navigation": "node scripts/navigation-smoke.cjs",
    "test:cache": "node scripts/cache-smoke.cjs",
    "test:scope": "node scripts/scope-smoke.cjs",
    "test:space": "node scripts/space-smoke.cjs",
    "test:restore": "node scripts/restore-smoke.cjs",
    "test:visibility": "node scripts/visibility-smoke.cjs",
    "build:native": "node scripts/build-native.cjs",
    "test:performance": "node scripts/performance-smoke.cjs",
    "test:index": "node scripts/index-pressure.cjs",
    "prebuild": "npm run build:native && npm run licenses",
    "pretest": "npm run build:native",
    "licenses": "node scripts/third-party-licenses.cjs",
    "test:storage": "node scripts/storage-acceptance.cjs",
    "test:accessibility": "node scripts/accessibility-acceptance.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "node-gyp": "12.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "io.diskharbor.desktop",
    "productName": "DiskHarbor",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "package.json",
      "!electron/native-src/**",
      "LICENSE",
      "THIRD_PARTY_LICENSES.txt"
    ],
    "linux": {
      "target": [
        "deb",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "asoming",
      "executableName": "diskharbor",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "DiskHarbor",
          "Name[zh_CN]": "盘清",
          "GenericName": "Disk space analyzer",
          "GenericName[zh_CN]": "磁盘空间分析",
          "Comment[zh_CN]": "查看文件占用，先预览再整理"
        }
      }
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.svg"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false
    },
    "asarUnpack": [
      "electron/native/**"
    ]
  },
  "type": "module",
  "desktopName": "diskharbor.desktop"
}
